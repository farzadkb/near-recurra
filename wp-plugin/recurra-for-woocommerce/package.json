{
  "name": "recurra-for-woocommerce-assets",
  "private": true,
  "description": "Builds assets/dist/recurra-wallet.js (wallet-selector glue). The built file is committed; no build step is needed to use the plugin.",
  "license": "MIT",
  "scripts": {
    "build": "esbuild assets/src/wallet.js --bundle --format=iife --global-name=RecurraWallet --target=es2020 --minify --legal-comments=linked --alias:util=./assets/src/shims/util.js --define:global=globalThis --outfile=assets/dist/recurra-wallet.js"
  },
  "devDependencies": {
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/hot-wallet": "10.1.4",
    "@near-wallet-selector/intear-wallet": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "esbuild": "0.28.2"
  }
}
