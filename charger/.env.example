# Copy to .env (git-ignored) or run: node src/keygen.ts <charger-account> <vault-id> <testnet|mainnet>
NEAR_NETWORK=testnet
# Optional; defaults to FastNEAR for NEAR_NETWORK.
RPC_URL=
VAULT_ID=vault-v2.recurra-farzad.testnet
CHARGER_ACCOUNT=charger.recurra-farzad.testnet
# Function-call access key limited to `charge` on VAULT_ID. Never commit it.
CHARGER_PRIVATE_KEY=
INTERVAL_SEC=60
